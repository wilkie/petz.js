{
  "name": "dogz-reverse",
  "version": "0.1.0",
  "description": "A clean-room TypeScript reimplementation of PF.Magic's Dogz (1995), and a knowledge base of what reverse engineering it found",
  "author": "wilkie",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "git config core.hooksPath .githooks",
    "kb": "vite build --config scripts/kb/vite.config.ts --logLevel warn && node dist/kb-build/build.js && pagefind --site dist/kb --silent",
    "oracle:fetch": "node scripts/oracle/fetch.mjs",
    "oracle:install": "node scripts/oracle/install-windows.mjs && node scripts/oracle/install-dogz.mjs",
    "oracle:register": "node scripts/oracle/register-dogz.mjs",
    "oracle:fingerprint": "node scripts/oracle/fingerprint.mjs",
    "oracle:run": "node scripts/oracle/run.mjs",
    "oracle": "pnpm oracle:fetch && pnpm oracle:install && pnpm oracle:register && pnpm oracle:fingerprint --check",
    "ci": "turbo run lint typecheck test"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "markdown-it": "^15.0.2",
    "pagefind": "1.5.2",
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
